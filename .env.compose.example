# ==========================================
# Environment Configuration for Docker Compose
# ==========================================
# Copy this file to .env before running: docker compose up -d --build

# Application port mapped on host (defaults to 3000)
APP_PORT=3000

# NextAuth base URL
NEXTAUTH_URL=http://localhost:3000

# Required: NextAuth session secret (min 32 characters, required by compose)
NEXTAUTH_SECRET=compose-nextauth-secret-min-32-chars-change-me!

# Required: HMAC secret for immutable storage integrity seals (min 32 characters, required by compose)
ORIGINAL_STORAGE_HMAC_SECRET=compose-hmac-secret-min-32-chars-change-me!

# HMAC key version identifier
ORIGINAL_STORAGE_KEY_ID=v1

# Enable/disable student results gate
STUDENT_RESULTS_ENABLED=true
