{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@cvit/ai": ["./packages/ai/src/index.ts"],
      "@cvit/ai/*": ["./packages/ai/src/*"],
      "@cvit/auth": ["./packages/auth/src/index.ts"],
      "@cvit/auth/*": ["./packages/auth/src/*"],
      "@cvit/api-client": ["./packages/api-client/src/index.ts"],
      "@cvit/api-client/*": ["./packages/api-client/src/*"],
      "@cvit/lti": ["./packages/lti/src/index.ts"],
      "@cvit/lti/*": ["./packages/lti/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
