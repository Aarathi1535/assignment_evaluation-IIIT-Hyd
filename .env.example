MONGODB_URI=your_mongodb_connection_string
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
ORIGINAL_STORAGE_HMAC_SECRET=your_original_storage_hmac_secret
ORIGINAL_STORAGE_KEY_ID=v1
DERIVED_PAGE_STORAGE_BUCKET=
# Server authorization gate for student results API
STUDENT_RESULTS_ENABLED=false
# UI display flag for student results navigation; must stay aligned with STUDENT_RESULTS_ENABLED
NEXT_PUBLIC_STUDENT_RESULTS_ENABLED=false

# Gemini AI Configuration (@google/genai)
# Deployment must supply valid model IDs; no hard-coded defaults are activated.
# Confirmed model IDs via models.list:
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_API_KEY=your_gemini_api_key_here
# Set to 'paid' or 'true' when a paid key is active to permit processing real student data:
# GEMINI_PAID_TIER=false

# Server authorization gate for learning module feature (default: false)
FEATURE_LEARNING_MODULE=false
# UI display flag for learning module navigation; must stay aligned with FEATURE_LEARNING_MODULE
NEXT_PUBLIC_FEATURE_LEARNING_MODULE=false

