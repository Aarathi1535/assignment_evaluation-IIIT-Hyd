MONGODB_URI=your_mongodb_connection_string
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
ORIGINAL_STORAGE_HMAC_SECRET=your_original_storage_hmac_secret
ORIGINAL_STORAGE_KEY_ID=v1
DERIVED_PAGE_STORAGE_BUCKET=
# Server authorization gate for student results API
STUDENT_RESULTS_ENABLED=false
# UI display flag for student results navigation; must stay aligned with STUDENT_RESULTS_ENABLED
NEXT_PUBLIC_STUDENT_RESULTS_ENABLED=false

# Gemini AI Configuration (@google/genai)
# Deployment must supply valid model IDs; no hard-coded defaults are activated.
# GEMINI_MODEL=
# GEMINI_EMBEDDING_MODEL=
# Mentor-required secret name for Gemini credentials:
# assignment-eval-gemini-api-key=your_gemini_api_key_here
# Optional uppercase aliases:
# ASSIGNMENT_EVAL_GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
