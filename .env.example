MONGODB_URI=your_mongodb_connection_string
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
ORIGINAL_STORAGE_HMAC_SECRET=your_original_storage_hmac_secret
ORIGINAL_STORAGE_KEY_ID=v1
DERIVED_PAGE_STORAGE_BUCKET=

# Research Feature Flags (default: false)
# FEATURE_CLASSROOM_ASSESSMENT=false
# NEXT_PUBLIC_FEATURE_CLASSROOM_ASSESSMENT=false
# FEATURE_PERSONALIZED_ASSESSMENT=false
# NEXT_PUBLIC_FEATURE_PERSONALIZED_ASSESSMENT=false

# Gemini AI Shared Service Configuration (@google/genai)
# Mentor-required secret name: assignment-eval-gemini-api-key
# Free Tier Note: Initially use the free tier ONLY with test images.
# Paid Tier Note: A paid Gemini API key must be used before any real student data is processed.
assignment-eval-gemini-api-key=your_gemini_api_key_here
# Optional uppercase POSIX alias:
# ASSIGNMENT_EVAL_GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Model & Tier Configuration:
# Default Model: gemini-1.5-flash
# GEMINI_MODEL=gemini-1.5-flash
# Set to 'paid' or 'true' when a paid key is active to permit processing real student data:
# GEMINI_PAID_TIER=false

# Optional storage roots for research photo submissions:
# CLASSROOM_STORAGE_PATH=
# PERSONALIZED_STORAGE_PATH=
