# ==========================================
# PRODUCT 1: ASSIGNMENT EVALUATION
# Independent Deployment Environment Config
# ==========================================

PORT=3000
NODE_ENV=production

# Independent Database Connection
MONGODB_URI=mongodb://mongo-assignment:27017/assignment_evaluation

# Independent Authentication & Session
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=assignment-eval-production-secret-replace-me

# Independent Local File Storage
UPLOAD_DIR=./data/submissions
RUBRIC_DIR=./data/rubrics

# Canvas Annotation / Worker Configuration
MAX_CONCURRENT_GRADING=5
ANNOTATION_STORAGE_TYPE=local

