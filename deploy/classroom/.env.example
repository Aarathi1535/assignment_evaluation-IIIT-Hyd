# ==========================================
# PRODUCT 2: CLASSROOM ACTIVITY
# Independent Deployment Environment Config
# ==========================================

PORT=3001
NODE_ENV=production

# Independent Database Connection
MONGODB_CLASSROOM_URI=mongodb://mongo-classroom:27017/classroom_activity
MONGODB_URI=mongodb://mongo-classroom:27017/classroom_activity

# Independent Authentication & Token Secret
CLASSROOM_AUTH_SECRET=classroom-activity-production-secret-replace-me

# Independent Storage Configuration
CLASSROOM_STORAGE_PATH=./data/classroom-uploads

# Feature Flags
NEXT_PUBLIC_ENABLE_CLASSROOM_ASSESSMENT=true

# AI / OCR Evaluation (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

