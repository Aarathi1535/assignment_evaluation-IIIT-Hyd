# ==========================================
# PRODUCT 3: PERSONALISED LEARNING
# Independent Deployment Environment Config
# ==========================================

PORT=3002
NODE_ENV=production

# Independent Database Connection
MONGODB_PERSONALIZED_URI=mongodb://mongo-personalized:27017/personalized_learning
MONGODB_URI=mongodb://mongo-personalized:27017/personalized_learning

# Independent Authentication & Token Secret
PERSONALIZED_AUTH_SECRET=personalized-learning-production-secret-replace-me

# Independent Storage Configuration
PERSONALIZED_STORAGE_PATH=./data/personalized-uploads
GCS_BUCKET_NAME=

# Feature Flags
NEXT_PUBLIC_ENABLE_PERSONALIZED_ASSESSMENT=true

# AI Generation Engine (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
